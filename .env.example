###############################################################################
# Hospital Management System - .env template
#
# SETUP:
#   cp .env.example .env      # .env is git-ignored, kabhi commit mat karna
#
# RULES (poore project ke liye):
#   1. Koi bhi secret (SECRET_KEY, DB password, Razorpay keys, Sentry DSN)
#      code mein HARDCODED nahi hoga - sirf yahan se aayega.
#   2. Production (Render) mein yehi values Render Dashboard > Environment
#      mein daalni hain, file upload nahi karni.
#   3. python-decouple bool cast: True/true/1/yes/on = True, False/false/0/no/off = False
###############################################################################

# ============ 1. CORE DJANGO (aaj zaroori) ============================
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-change-me-in-production

# Local dev ke liye True. Server pe HAMESHA False.
DEBUG=True

# Comma separated. SaaS subdomains wildcard se cover hote hain: *.example.com
ALLOWED_HOSTS=
# HTTPS domain jahan se forms POST honge (Django ka CSRF Origin check).
# Scheme ke SAATH likho, comma separated. SAAS_ROOT_DOMAIN aur ALLOWED_HOSTS se
# settings.py khud bhi bana leta hai - yeh sirf extra/custom domains ke liye hai
# (jaise ngrok tunnel, staging proxy, ya preview URL).
#   example: CSRF_TRUSTED_ORIGINS=https://app.example.com,https://staging.example.com
CSRF_TRUSTED_ORIGINS=

# Cookie SameSite policy: 'Lax' (default, safe) ya 'None'.
# 'None' sirf tab karo jab app kisi DOOSRI site ke IFRAME mein khul rahi ho
# (preview pane / embedded dashboard) - warna form POST pe "CSRF cookie not set"
# aata hai. 'None' ke saath cookies Secure ho jaati hain, matlab HTTPS zaroori.
COOKIE_SAMESITE=Lax

# Render khud inject karta hai - manually set karne ki zaroorat nahi.
# settings.py isse ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS mein add karta hai.
RENDER_EXTERNAL_HOSTNAME=

# Reverse proxy (Render/Nginx) ke SSL header ko trust karna - iske bina
# SECURE_SSL_REDIRECT infinite redirect loop bana deta hai.
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# ============ 2. DATABASE ============================================
# Local dev (khaali chhoda) -> SQLite (db.sqlite3), jaldi start hota hai.
# Production -> Render ka "Internal Database URL" paste karo:
#   postgres://user:password@host:5432/dbname
# NOTE: Render pe "psycopg2" driver use karo, "psycopg" (v3) nahi -
#       requirements.txt mein psycopg2-binary pinned hai.
DATABASE_URL=

# ============ 3. SAAS / MULTI-TENANCY (Phase 1) ======================
# Tenant kaunsa domain scheme use karega.
#   subdomain -> acme.example.com (DNS wildcard *.example.com zaroori hai)
#   path      -> example.com/acme/ (subdomain DNS nahi chahiye; fallback)
TENANCY_MODE=subdomain

# Apna main (root) domain, bina protocol ke. Subdomain isi se resolve hoga.
# Local test: SAAS_ROOT_DOMAIN=localhost + /etc/hosts mein acme.localhost 127.0.0.1
SAAS_ROOT_DOMAIN=localhost

# Session-based tenant resolution ka fallback (jab subdomain na mile):
# user login ke baad session mein tenant slug store hota hai.
TENANCY_SESSION_KEY=hospital_slug

# Root domain pe bina tenant ke request aaye to login pe redirect karo (True).
# False karne se tenant-less request bina redirect ke chalengi (sirf debug ke liye).
TENANT_REQUIRED=True

# In paths pe tenant enforcement nahi (comma separated). Login yahan zaroori hai,
# warna login page khud redirect loop mein phans jaata hai.
TENANT_EXEMPT_PATHS=/accounts/login/,/admin/login/,/healthz

# Phase 1 migration mein jo "Default Hospital" banega - purana saara data
# usi ko assign hoga. Naam badalne se data pe koi asar nahi padta.
DEFAULT_HOSPITAL_NAME=Default Hospital
DEFAULT_HOSPITAL_SLUG=default

# ============ 4. RAZORPAY (Phase 2 - subscriptions) ==================
# Test mode keys: Dashboard > Settings > API Keys (test mode switch ON)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret: Dashboard > Webhooks > Add > "Secret" (signature verify ke liye)
RAZORPAY_WEBHOOK_SECRET=
# Webhook ka public URL - Razorpay Dashboard > Webhooks mein yahi daalna hai:
#   https://<tumhara-domain>/saas/webhook/
# (subdomain nahi, root domain - isliye yeh path TENANT_EXEMPT_PATHS mein hai)
RAZORPAY_WEBHOOK_URL=
RAZORPAY_CURRENCY=INR

# Payment fail hone ke baad kitne din tak hospital ka access chalu rahe.
# 0 karne se payment fail hote hi access band ho jaata hai (harsh).
SUBSCRIPTION_GRACE_DAYS=3

# ============ 5. CELERY / REDIS (Phase 3 - async risk scoring) =======
# Local (Redis ke bina): CELERY_TASK_ALWAYS_EAGER=True -> tasks sync chalenge
# Local (Redis ke saath): redis://127.0.0.1:6379/0
# Render: redis://<internal-host>:6379/0  (ek Redis instance banana padega)
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# True = broker ke bina task turant chalega (local dev / tests ke liye)
CELERY_TASK_ALWAYS_EAGER=True

# Worker chalane ka command (production):
#   celery -A hospital_system worker -l info

# ============ 6. ML / NO-SHOW PREDICTION (Phase 3) ===================
# Isse kam labelled appointments -> rule-based fallback score (cold start)
ML_MIN_TRAINING_ROWS=250
# Trained joblib models kahan rahenge (git-ignored).
# NOTE: Render ka filesystem EPHEMERAL hai -> deploy ke baad retrain karo
# (release command) ya artifacts object storage (S3/GCS) mein rakho.
ML_MODEL_DIR=ml_models
# 0.0 - 1.0 ; isse upar wala appointment "HIGH risk" kehlata hai
ML_HIGH_RISK_THRESHOLD=0.65
ML_MEDIUM_RISK_THRESHOLD=0.40
# Appointment create hote hi async score karein?
ML_AUTO_SCORE_ON_CREATE=True

# ============ 7. API LAYER (Phase 4 - DRF + JWT) =====================
# JWT lifetimes. Access token chhota rakho; refresh se naya lo.
SIMPLE_JWT_ACCESS_TOKEN_MINUTES=60
SIMPLE_JWT_REFRESH_TOKEN_DAYS=7
# API ka plan gate: yeh feature jiske plan mein nahi, usko 402 milta hai
# (code mein fixed hai: subscriptions.models.Feature.API_ACCESS)
# Swagger UI: /api/docs/   |  OpenAPI schema: /api/schema/

# ============ 8. SENTRY (Phase 5 - error monitoring) =================
# Project Settings > Client Keys (DSN). Khaali = Sentry off, koi error nahi.
SENTRY_DSN=
# 0.0 - 1.0 (kitne events bhejein; production mein 0.1-1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Release tag, taaki kaunsa deploy fail hua pata chale (git SHA best hai)
SENTRY_RELEASE=
# local / staging / production
SENTRY_ENVIRONMENT=local

# ============ 8b. DOCKER / COMPOSE (Phase 5) =========================
# docker compose up ke liye. Web app inhe padhta nahi - compose inhe use
# karke DATABASE_URL khud banata hai.
POSTGRES_DB=hospital_saas
POSTGRES_USER=hospital
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432
# Host pe web kis port pe dikhe (container andar 8000 pe chalta hai)
WEB_PORT=8000

# ============ 9. STATIC FILES (gunicorn + whitenoise) ================
# Render build command mein `collectstatic` chalao; yeh path usi ka output hai.
STATIC_ROOT=staticfiles

# ============ 10. EMAIL (optional - abhi app email nahi bhejta) ======
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com

# ============ 11. SESSION / IDLE TIMEOUT (app ke existing values) ====
# core.middleware.IdleSessionTimeoutMiddleware isi ko padhta hai.
SESSION_COOKIE_AGE=1800
IDLE_TIMEOUT_SECONDS=1800
