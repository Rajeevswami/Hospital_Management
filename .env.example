###############################################################################
# Hospital Management System - .env template
#
# SETUP:
#   cp .env.example .env      # .env is git-ignored, never commit it
#
# RULES (for the whole project):
#   1. No secret (SECRET_KEY, DB password, Razorpay keys, Sentry DSN)
#      will be HARDCODED in the code - it must come from here only.
#   2. In production (Render), put these same values into Render Dashboard >
#      Environment; do not upload the file.
#   3. python-decouple bool cast: True/true/1/yes/on = True, False/false/0/no/off = False
###############################################################################

# ============ 1. CORE DJANGO (required today) ========================
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-change-me-in-production

# True for local dev. ALWAYS False on the server.
DEBUG=True

# Comma separated. SaaS subdomains are covered by a wildcard: *.example.com
ALLOWED_HOSTS=
# HTTPS domain(s) where forms will POST from (Django's CSRF Origin check).
# Write WITH the scheme, comma separated. settings.py already derives entries
# from SAAS_ROOT_DOMAIN and ALLOWED_HOSTS - this is only for extra/custom
# domains (e.g. an ngrok tunnel, a staging proxy, or a preview URL).
#   example: CSRF_TRUSTED_ORIGINS=https://app.example.com,https://staging.example.com
CSRF_TRUSTED_ORIGINS=

# Cookie SameSite policy: 'Lax' (default, safe) or 'None'.
# Only use 'None' when the app must open inside ANOTHER site's IFRAME
# (preview pane / embedded dashboard) - otherwise form POSTs fail with
# "CSRF cookie not set". With 'None', cookies become Secure, so HTTPS is required.
COOKIE_SAMESITE=Lax

# Render injects this automatically - no need to set it manually.
# settings.py adds it to ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS.
RENDER_EXTERNAL_HOSTNAME=

# Trust the reverse proxy's (Render/Nginx) SSL header - without this,
# SECURE_SSL_REDIRECT creates an infinite redirect loop.
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# ============ 2. DATABASE ============================================
# Local dev (leave empty) -> SQLite (db.sqlite3), starts up quickly.
# Production -> paste Render's "Internal Database URL":
#   postgres://user:password@host:5432/dbname
# NOTE: On Render use the "psycopg2" driver, not "psycopg" (v3) -
#       requirements.txt pins psycopg2-binary.
# Leave it EMPTY -> SQLite (db.sqlite3) is used automatically. This is the
# easiest option for local dev. For Postgres, add the value after the equals sign.
DATABASE_URL=

# ============ 3. SAAS / MULTI-TENANCY (Phase 1) ======================
# Which domain scheme a tenant uses.
#   subdomain -> acme.example.com (requires DNS wildcard *.example.com)
#   path      -> example.com/acme/ (no subdomain DNS needed; fallback)
TENANCY_MODE=subdomain

# Your main (root) domain, without the protocol. Subdomains resolve from it.
# Local test: SAAS_ROOT_DOMAIN=localhost + map acme.localhost 127.0.0.1 in /etc/hosts
SAAS_ROOT_DOMAIN=localhost

# Fallback for session-based tenant resolution (when the subdomain is missing):
# after login, the tenant slug is stored in the session.
TENANCY_SESSION_KEY=hospital_slug

# Redirect tenant-less requests on the root domain to login (True).
# With False, tenant-less requests run without a redirect (debug only).
TENANT_REQUIRED=True

# Paths without tenant enforcement (comma separated). Login must be listed
# here, otherwise the login page itself gets stuck in a redirect loop.
TENANT_EXEMPT_PATHS=/accounts/login/,/admin/login/,/healthz

# The "Default Hospital" created by the Phase 1 migration - all pre-existing
# data is assigned to it. Renaming it does not affect the data.
DEFAULT_HOSPITAL_NAME=Default Hospital
DEFAULT_HOSPITAL_SLUG=default

# ============ 4. RAZORPAY (Phase 2 - subscriptions) ==================
# Test mode keys: Dashboard > Settings > API Keys (test mode switch ON)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret: Dashboard > Webhooks > Add > "Secret" (for signature verification)
RAZORPAY_WEBHOOK_SECRET=
# The webhook's public URL - put this exact URL in the Razorpay Dashboard > Webhooks:
#   https://<your-domain>/saas/webhook/
# (the root domain, not a subdomain - that is why this path is in TENANT_EXEMPT_PATHS)
RAZORPAY_WEBHOOK_URL=
RAZORPAY_CURRENCY=INR

# How many days the hospital keeps access after a failed payment.
# Setting 0 cuts access off as soon as a payment fails (harsh).
SUBSCRIPTION_GRACE_DAYS=3

# ============ 5. CELERY / REDIS (Phase 3 - async risk scoring) =======
# Local (without Redis): CELERY_TASK_ALWAYS_EAGER=True -> tasks run synchronously
# Local (with Redis): redis://127.0.0.1:6379/0
# Render: redis://<internal-host>:6379/0  (you need to create a Redis instance)
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# True = tasks run immediately without a broker (local dev / tests)
CELERY_TASK_ALWAYS_EAGER=True

# Command to run the worker (production):
#   celery -A hospital_system worker -l info

# ============ 6. ML / NO-SHOW PREDICTION (Phase 3) ===================
# Fewer labelled appointments than this -> rule-based fallback score (cold start)
ML_MIN_TRAINING_ROWS=250
# Where trained joblib models live (git-ignored).
# NOTE: Render's filesystem is EPHEMERAL -> retrain after deploy
# (release command) or keep artifacts in object storage (S3/GCS).
ML_MODEL_DIR=ml_models
# 0.0 - 1.0 ; appointments above this are called "HIGH risk"
ML_HIGH_RISK_THRESHOLD=0.65
ML_MEDIUM_RISK_THRESHOLD=0.40
# Score asynchronously as soon as an appointment is created?
ML_AUTO_SCORE_ON_CREATE=True

# ============ 7. API LAYER (Phase 4 - DRF + JWT) =====================
# JWT lifetimes. Keep the access token short; get a new one with the refresh token.
SIMPLE_JWT_ACCESS_TOKEN_MINUTES=60
SIMPLE_JWT_REFRESH_TOKEN_DAYS=7
# API plan gate: a plan without this feature gets a 402 response
# (fixed in code: subscriptions.models.Feature.API_ACCESS)
# Swagger UI: /api/docs/   |  OpenAPI schema: /api/schema/

# ============ 8. SENTRY (Phase 5 - error monitoring) =================
# Project Settings > Client Keys (DSN). Empty = Sentry off, no errors raised.
SENTRY_DSN=
# 0.0 - 1.0 (how many events to send; 0.1-1.0 in production)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Release tag, so it is clear which deploy failed (git SHA is best)
SENTRY_RELEASE=
# local / staging / production
SENTRY_ENVIRONMENT=local

# ============ 8b. DOCKER / COMPOSE (Phase 5) =========================
# For docker compose up. The web app does not read these - compose uses them
# to build DATABASE_URL itself.
POSTGRES_DB=hospital_saas
POSTGRES_USER=hospital
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432
# Which host port the web app is exposed on (it runs on 8000 inside the container)
WEB_PORT=8000

# ============ 9. STATIC FILES (gunicorn + whitenoise) ================
# Run `collectstatic` in the Render build command; this path is its output.
STATIC_ROOT=staticfiles

# ============ 10. EMAIL (optional - the app does not send email yet) ==
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com

# ============ 11. SESSION / IDLE TIMEOUT (existing app values) =======
# core.middleware.IdleSessionTimeoutMiddleware reads this.
SESSION_COOKIE_AGE=1800
IDLE_TIMEOUT_SECONDS=1800
